{
  "name": "gated",
  "version": "0.3.0",
  "description": "Type-safe feature flag library for TypeScript applications",
  "keywords": [
    "ab-testing",
    "feature-flags",
    "feature-gates",
    "feature-management",
    "feature-toggles",
    "launchdarkly",
    "posthog",
    "react",
    "statsig",
    "type-safe",
    "typescript",
    "variants"
  ],
  "homepage": "https://github.com/adelrodriguez/gated#readme",
  "bugs": {
    "url": "https://github.com/adelrodriguez/gated/issues"
  },
  "license": "MIT",
  "author": "Adel Rodriguez",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adelrodriguez/gated.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./hooks": {
      "types": "./dist/hooks/index.d.ts",
      "import": "./dist/hooks/index.js",
      "default": "./dist/hooks/index.js"
    },
    "./react": {
      "types": "./dist/integrations/react.d.ts",
      "import": "./dist/integrations/react.js",
      "default": "./dist/integrations/react.js"
    }
  },
  "scripts": {
    "analyze": "adamantite analyze",
    "build": "bunup",
    "bump:deps": "bun update --interactive",
    "check": "adamantite check",
    "dev": "bunup --watch",
    "fix": "adamantite fix",
    "format": "adamantite format",
    "release": "changeset publish",
    "test": "bun test --parallel",
    "test:coverage": "bun test --coverage",
    "test:watch": "bun test --watch",
    "version": "changeset version && bun run format"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.0",
    "@happy-dom/global-registrator": "20.11.2",
    "@testing-library/react": "16.3.2",
    "@types/bun": "1.3.14",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "adamantite": "^0.34.4",
    "bunup": "0.16.32",
    "knip": "6.32.2",
    "oxfmt": "0.63.0",
    "oxlint": "1.78.0",
    "oxlint-tsgolint": "7.0.2001",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "react": "^19.2.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "packageManager": "bun@1.3.14"
}
