{
  "name": "gated",
  "version": "0.2.0",
  "description": "Type-safe feature flag library for TypeScript applications",
  "keywords": [
    "ab-testing",
    "feature-flags",
    "feature-gates",
    "feature-management",
    "feature-toggles",
    "launchdarkly",
    "posthog",
    "react",
    "statsig",
    "type-safe",
    "typescript",
    "variants"
  ],
  "homepage": "https://github.com/adelrodriguez/gated#readme",
  "bugs": {
    "url": "https://github.com/adelrodriguez/gated/issues"
  },
  "license": "MIT",
  "author": "Adel Rodriguez",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adelrodriguez/gated.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./hooks": {
      "types": "./dist/hooks/index.d.ts",
      "import": "./dist/hooks/index.js",
      "default": "./dist/hooks/index.js"
    },
    "./react": {
      "types": "./dist/integrations/react.d.ts",
      "import": "./dist/integrations/react.js",
      "default": "./dist/integrations/react.js"
    }
  },
  "scripts": {
    "analyze": "adamantite analyze",
    "build": "tsdown",
    "build:verify": "pnpm run build && node scripts/verify-build.ts",
    "bump:deps": "pnpm update --interactive",
    "check": "adamantite check",
    "dev": "tsdown --watch",
    "fix": "adamantite fix",
    "release": "changeset publish",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "version": "changeset version && pnpm run fix"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.0.1",
    "adamantite": "0.43.0",
    "happy-dom": "20.14.5",
    "knip": "6.39.0",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "oxlint-tsgolint": "7.0.2003",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tsdown": "0.23.0",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  },
  "peerDependencies": {
    "react": "^19.2.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "packageManager": "pnpm@12.5.1"
}
