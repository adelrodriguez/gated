{
  "name": "gated",
  "version": "0.1.2",
  "description": "Type-safe feature flag library for TypeScript applications",
  "keywords": [
    "ab-testing",
    "feature-flags",
    "feature-gates",
    "feature-management",
    "feature-toggles",
    "launchdarkly",
    "posthog",
    "react",
    "statsig",
    "type-safe",
    "typescript",
    "variants"
  ],
  "homepage": "https://github.com/adelrodriguez/gated#readme",
  "bugs": {
    "url": "https://github.com/adelrodriguez/gated/issues"
  },
  "license": "MIT",
  "author": "Adel Rodriguez",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adelrodriguez/gated.git"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./hooks": "./src/hooks/index.ts",
    "./hooks/recipes": "./src/hooks/recipes.ts",
    "./react": "./src/integrations/react.tsx"
  },
  "scripts": {
    "analyze": "adamantite analyze",
    "build": "bunup",
    "bump:deps": "bun update --interactive",
    "check": "adamantite check",
    "dev": "bunup --watch",
    "fix": "adamantite fix",
    "format": "adamantite format",
    "release": "changeset publish",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "test:watch": "bun test --watch",
    "typecheck": "adamantite typecheck",
    "version": "changeset version && bun run format"
  },
  "devDependencies": {
    "@changesets/cli": "2.29.7",
    "@happy-dom/global-registrator": "^20.0.8",
    "@testing-library/react": "16.3.0",
    "@types/bun": "1.3.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "adamantite": "^0.30.2",
    "bunup": "0.16.31",
    "knip": "5.85.0",
    "oxfmt": "0.35.0",
    "oxlint": "1.50.0",
    "oxlint-tsgolint": "0.14.2",
    "react-dom": "19.2.0",
    "typescript": "5.9.3"
  },
  "peerDependencies": {
    "react": "^19.2.0",
    "typescript": "^5"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  }
}
